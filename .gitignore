# Swift / SPM
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace
DerivedData/
*.dSYM/

# Build products. Scripts/make-app.sh assembles the bundle into build/.
build/
dist/
*.app/
*.dmg

# The anonymization mapping is the reverse lookup for the fixtures.
# Committing it would undo the anonymization it performs.
Scripts/anonymize-map.json

# Raw, un-anonymized captures. Only sanitized fixtures under Tests/Fixtures/ are tracked.
Tests/Fixtures/raw-*/
Tests/Fixtures/local-*/
*.capture

# Local runtime state
*.db
*.db-wal
*.db-shm
reap.log

# Claude Code's own working state, which lands inside the repository it is working on.
# .claude/worktrees/ holds whole checkouts; committing one would nest the repo in itself.
# Shared configuration under .claude/ is not ignored, so a settings.json meant for
# everyone can still be committed.
.claude/worktrees/
.claude/state/
.claude/settings.local.json

# Secrets and local config
.env
.env.*
!.env.example
.infisical.json
*.pem
*.p12
*.mobileprovision

# Editors
.vscode/
.idea/
*.swp
*~

# macOS
.DS_Store
._*
